# Variaveis esperadas pelo backend TRACEFLOW.
# TODO: Criar backend/.env local com valores adequados ao ambiente de desenvolvimento.
NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://usuario:senha@localhost:3306/traceflow"
TEST_DATABASE_URL="mysql://usuario:senha@localhost:3306/traceflow_test"
GITHUB_TOKEN="seu_token_do_github"
FRONTEND_URL="http://localhost:5173"
BODY_LIMIT="100kb"
CORS_ALLOWED_ORIGINS="http://localhost:5173"
CORS_ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,X-Request-Id,X-CSRF-Token"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
SENSITIVE_RATE_LIMIT_MAX=20
GITHUB_REQUEST_TIMEOUT_MS=15000
GITHUB_RETRY_MAX=2
TRUST_PROXY=false
SESSION_TTL_MS=28800000
PASSWORD_RESET_TTL_MS=1800000
INVITATION_TTL_MS=604800000
SESSION_COOKIE_NAME="traceflow_session"
SESSION_COOKIE_SAME_SITE="lax"
