# OCI-DEPLOY-03: contrato, não configuração operacional. Não preencher segredos neste arquivo.
# Supervisor fornece o ambiente; env.js não carrega dotenv em produção.
# Gerar Prisma em build sem .env e nunca incluir .env na release.
NODE_ENV=production
PORT=3001
HTTP_HOST=127.0.0.1
TRUST_PROXY=loopback
RATE_LIMIT_PROFILE=production
FRONTEND_URL=https://traceflow.dev
CORS_ALLOWED_ORIGINS=https://traceflow.dev

# REQUIRED_PRODUCTION + SECRET. Fornecer fora do Git, após homologação HeatWave.
# URL mysql, usuário de runtime próprio, senha URL-encoded, host/CA verificados.
# Transporte planejado: sslaccept=strict, sslcert=<CA absoluta>; nunca accept_invalid_certs.
# Dimensionar connection_limit para API + worker; connect_timeout/pool_timeout/socket_timeout finitos.
# TLS/identidade/permissões do banco gerenciado AINDA NÃO HOMOLOGADOS.
DATABASE_URL=
PRIVACY_PSEUDONYMIZATION_KEY=

# URLs reais da SPA, explicitamente obrigatórias em produção.
PASSWORD_RESET_URL=https://traceflow.dev/reset-password
INVITATION_ACCEPT_URL=https://traceflow.dev/invitations/accept
EMAIL_VERIFICATION_URL=https://traceflow.dev/verify-email
EMAIL_CHANGE_CONFIRM_URL=https://traceflow.dev/settings/account/email-change/confirm
ACCOUNT_REACTIVATION_URL=https://traceflow.dev/account/reactivation/confirm

# SMTP: escolher provedor; credenciais ficam fora do Git. Não usar capture em produção.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# false em 587 significa STARTTLS obrigatório em produção. Para 465 usar true (TLS implícito).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# GitHub App: contrato compartilhado por API/worker, mesmo para contas locais sem OAuth.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CALLBACK_URL=https://traceflow.dev/api/github-app/callback
GITHUB_LOGIN_CALLBACK_URL=https://traceflow.dev/api/auth/github/callback
GITHUB_APP_FRONTEND_SUCCESS_URL=https://traceflow.dev/projects?github=connected
GITHUB_APP_FRONTEND_ERROR_URL=https://traceflow.dev/projects?github=error
# Webhook remoto futuro: https://traceflow.dev/api/webhooks/github-app

# API não inicia scheduler. Na configuração do processo worker, true é OBRIGATÓRIO.
GITHUB_SCHEDULER_ENABLED=false
GITHUB_SYNC_INTERVAL_MS=1800000
GITHUB_SCHEDULER_TICK_MS=15000
GITHUB_AUTOMATIC_CONCURRENCY=2
GITHUB_SYNC_LEASE_MS=1800000
GITHUB_SYNC_BACKOFF_MAX_MS=21600000
GITHUB_REQUEST_TIMEOUT_MS=15000
GITHUB_RETRY_MAX=2
GITHUB_RETRY_MAX_DELAY_MS=60000

# Diretório real, existente, privado (0700), de propriedade do usuário traceflow.
# Não usar current, /opt/traceflow, webroot, frontend ou diretório da release.
TEST_EVIDENCE_STORAGE_DIR=/var/lib/traceflow/test-evidence
SHUTDOWN_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=3000
# Demais limites/TTLs/retention opcionais conservam defaults de env.js (ver OCI_ENVIRONMENT.md).
# TEST_DATABASE_URL é exclusiva de testes isolados e não pertence ao ambiente de produção.
