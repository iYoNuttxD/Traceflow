# Copie para .env.test e use somente um banco MySQL descartavel de testes.
NODE_ENV=test
TEST_DATABASE_URL="mysql://usuario:senha@localhost:3306/traceflow_test"
BODY_LIMIT="100kb"
CORS_ALLOWED_ORIGINS="http://frontend.test"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
SENSITIVE_RATE_LIMIT_MAX=100
GITHUB_REQUEST_TIMEOUT_MS=1000
GITHUB_RETRY_MAX=0
TRUST_PROXY=false
