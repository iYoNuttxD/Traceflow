# Copie para .env.test e use somente um banco MySQL descartavel de testes.
NODE_ENV=test
TEST_DATABASE_URL="mysql://usuario:senha@localhost:3306/traceflow_test"
BODY_LIMIT="100kb"
CORS_ALLOWED_ORIGINS="http://frontend.test"
CORS_ALLOWED_HEADERS="Content-Type,X-Request-Id,X-CSRF-Token"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
SENSITIVE_RATE_LIMIT_MAX=1000
GITHUB_REQUEST_TIMEOUT_MS=1000
GITHUB_RETRY_MAX=0
TRUST_PROXY=false
SESSION_TTL_MS=28800000
PASSWORD_RESET_TTL_MS=1800000
INVITATION_TTL_MS=604800000
SESSION_COOKIE_NAME="traceflow_session"
SESSION_COOKIE_SAME_SITE="lax"
EMAIL_PROVIDER="capture"
EMAIL_FROM="no-reply@traceflow.test"
PASSWORD_RESET_URL="http://frontend.test/reset-password"
INVITATION_ACCEPT_URL="http://frontend.test/invitations/accept"
