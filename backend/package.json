{
  "name": "traceflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend do TRACEFLOW em Node.js e Express",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration test/api",
    "test:coverage": "vitest run --coverage",
    "architecture:check": "node scripts/check-architecture.js",
    "security:secrets": "node scripts/check-secrets.js",
    "e6:backfill:dry-run": "node scripts/backfill-e6-memberships.js",
    "e6:backfill": "node scripts/backfill-e6-memberships.js --apply",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
