{
  "name": "traceflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend do TRACEFLOW em Node.js e Express",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src test scripts vitest.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"*.js\" package.json",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"*.js\" package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration test/api",
    "test:coverage": "vitest run --coverage",
    "architecture:check": "node scripts/check-architecture.js",
    "security:secrets": "node scripts/check-secrets.js",
    "e6:backfill:dry-run": "node scripts/backfill-e6-memberships.js",
    "e6:backfill": "node scripts/backfill-e6-memberships.js --apply",
    "e6:cleanup:dry-run": "node scripts/cleanup-auth-records.js",
    "e6:cleanup": "node scripts/cleanup-auth-records.js --apply",
    "privacy:retention:dry-run": "node scripts/privacy-retention.js",
    "privacy:retention": "node scripts/privacy-retention.js --apply",
    "privacy:deletions:dry-run": "node scripts/process-account-deletions.js",
    "privacy:deletions": "node scripts/process-account-deletions.js --apply",
    "e8:audit": "node scripts/e8-schema-audit.js",
    "e8:reconcile:dry-run": "node scripts/e8-reconcile.js",
    "e8:reconcile": "node scripts/e8-reconcile.js --apply",
    "e8:contract:dry-run": "node scripts/e8-contract.js",
    "e8:contract": "node scripts/e8-contract.js --apply",
    "e11:legacy:audit": "node scripts/e11-legacy-responsibility-audit.js",
    "e11:legacy:reconcile:dry-run": "node scripts/e11-reconcile-legacy-responsibilities.js",
    "e11:legacy:reconcile": "node scripts/e11-reconcile-legacy-responsibilities.js --apply",
    "db:test:migrate": "node scripts/test-database.js migrate",
    "db:test:status": "node scripts/test-database.js status",
    "db:test:validate-empty": "node scripts/validate-empty-migrations.js",
    "db:test:validate-lr2-legacy": "node scripts/validate-lr2-legacy-migration.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.9.6",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
