generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum PrivacyRequestType {
  DATA_EXPORT
  ACCOUNT_DEACTIVATION
  ACCOUNT_DELETION
  DATA_CORRECTION
}

enum PrivacyRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
  REJECTED
}

enum PersonalDataExportStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum TaskCommitSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum TaskHistoryField {
  STATUS
  DEADLINE
  RESPONSIBLE
  PRIORITY
}

enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum GitHubIntegrationStatus {
  ACTIVE
  RECONNECT_REQUIRED
  DISCONNECTED
}

enum GitHubSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum GitHubSyncStep {
  QUEUED
  REPOSITORY
  BRANCHES
  COMMITS
  PULL_REQUESTS
  ISSUES
  PERSIST
  COMPLETED
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
  DELETION_PENDING
  ANONYMIZED
}

enum GitHubOAuthPurpose {
  LOGIN
  LINK_IDENTITY
  REAUTH_SET_PASSWORD
}

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  username          String        @unique
  mustSetUsername   Boolean       @default(false)
  passwordHash      String?
  isActive          Boolean       @default(true)
  emailVerifiedAt   DateTime?
  mustSetPassword   Boolean       @default(false)
  sessionVersion    Int           @default(1)
  accountStatus     AccountStatus @default(ACTIVE)
  deactivatedAt     DateTime?
  usernameChangedAt DateTime?
  anonymizedAt      DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sessions                         Session[]
  passwordResetTokens              PasswordResetToken[]
  emailVerificationTokens          EmailVerificationToken[]
  memberships                      ProjectMembership[]
  createdInvitations               ProjectInvitation[]               @relation("InvitationCreator")
  acceptedInvitations              ProjectInvitation[]               @relation("InvitationAcceptor")
  declinedInvitations              ProjectInvitation[]               @relation("InvitationDecliner")
  responsibleTasks                 Task[]
  taskMovements                    TaskMovement[]
  taskHistoryEntries               TaskHistoryEntry[]
  auditEvents                      AuditEvent[]
  privacyRequests                  PrivacyRequest[]
  personalDataExports              PersonalDataExport[]
  reviewedTaskCommitSuggestions    TaskCommitSuggestion[]            @relation("TaskCommitSuggestionReviewer")
  githubInstallationAuthorizations GitHubInstallationAuthorization[]
  githubAppConnectionStates        GitHubAppConnectionState[]
  githubIdentity                   GitHubIdentity?
  githubOAuthStates                GitHubOAuthState[]
  emailChangeRequests              EmailChangeRequest[]
  accountReactivationTokens        AccountReactivationToken[]
  requestedGitHubSyncRuns          GitHubSyncRun[]

  @@index([accountStatus])
}

model Session {
  id             Int       @id @default(autoincrement())
  publicId       String    @unique @default(uuid())
  userId         Int
  tokenHash      String    @unique
  csrfTokenHash  String
  sessionVersion Int
  expiresAt      DateTime
  rememberMe     Boolean   @default(false)
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubAppConnectionStates GitHubAppConnectionState[]
  githubOAuthStates         GitHubOAuthState[]
  lastReauthenticatedAt     DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeRequest {
  id                   Int       @id @default(autoincrement())
  userId               Int
  currentEmailSnapshot String
  newEmail             String
  tokenHash            String    @unique
  expiresAt            DateTime
  verifiedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([newEmail])
}

model AccountReactivationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProjectMembership {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)
  isActive  Boolean     @default(true)
  joinedAt  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, role, isActive])
  @@index([userId, isActive])
}

model ProjectInvitation {
  id           Int         @id @default(autoincrement())
  projectId    Int
  email        String
  role         ProjectRole @default(MEMBER)
  tokenHash    String      @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  acceptedAt   DateTime?
  declinedAt   DateTime?
  createdById  Int
  acceptedById Int?
  declinedById Int?
  createdAt    DateTime    @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedBy User?   @relation("InvitationAcceptor", fields: [acceptedById], references: [id])
  declinedBy User?   @relation("InvitationDecliner", fields: [declinedById], references: [id])

  @@index([projectId])
  @@index([email])
  @@index([projectId, email, createdAt])
  @@index([expiresAt])
  @@index([declinedById])
}

// Entidade central do TRACEFLOW, com aliases GitHub legados preservados por compatibilidade.
model Project {
  id                       Int       @id @default(autoincrement())
  name                     String
  description              String?
  responsibleTeam          String
  githubOwner              String?
  githubRepo               String?
  githubUrl                String?
  githubRepositoryId       String?
  githubRepositoryName     String?
  githubRepositoryFullName String?
  githubRepositoryUrl      String?
  githubDefaultBranch      String?
  githubIsPrivate          Boolean?
  githubIntegratedAt       DateTime?
  githubAutoSyncEnabled    Boolean   @default(false)
  githubLastSyncAt         DateTime?
  githubSyncStatus         String?
  githubLastSyncError      String?
  githubLastSyncAttemptAt  DateTime?
  status                   String    @default("ATIVO")
  accessCode               String?   @unique
  inviteLink               String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  requirements           Requirement[]
  tasks                  Task[]
  members                ProjectMember[]
  taskMovements          TaskMovement[]
  taskHistoryEntries     TaskHistoryEntry[]
  commits                Commit[]
  pullRequests           PullRequest[]
  issues                 Issue[]
  memberships            ProjectMembership[]
  invitations            ProjectInvitation[]
  auditEvents            AuditEvent[]
  taskCommitSuggestions  TaskCommitSuggestion[]
  githubIntegration      ProjectGitHubIntegration?
  githubConnectionStates GitHubAppConnectionState[]
  githubBranches         GitBranch[]
  githubSyncRuns         GitHubSyncRun[]

  @@unique([githubRepositoryId])
  @@unique([githubRepositoryFullName])
  @@index([status])
  @@index([githubSyncStatus])
  @@index([createdAt])
}

model GitHubInstallation {
  id                   Int                      @id @default(autoincrement())
  githubInstallationId String                   @unique
  accountId            String
  accountLogin         String
  accountType          String
  status               GitHubInstallationStatus @default(ACTIVE)
  suspendedAt          DateTime?
  installedAt          DateTime
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  authorizations      GitHubInstallationAuthorization[]
  projectIntegrations ProjectGitHubIntegration[]

  @@index([accountId])
  @@index([status])
}

model GitHubInstallationAuthorization {
  id             Int      @id @default(autoincrement())
  installationId Int
  userId         Int
  verifiedAt     DateTime
  createdAt      DateTime @default(now())

  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([installationId, userId])
  @@index([userId])
}

model ProjectGitHubIntegration {
  id                 Int                     @id @default(autoincrement())
  projectId          Int                     @unique
  installationId     Int?
  githubRepositoryId String?                 @unique
  repositoryName     String?
  repositoryFullName String?
  repositoryUrl      String?
  defaultBranch      String?
  status             GitHubIntegrationStatus @default(RECONNECT_REQUIRED)
  lastValidatedAt    DateTime?
  lastSyncAt         DateTime?
  lastSyncStatus     String?
  lastSyncError      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installation GitHubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([installationId, status])
}

model GitHubAppConnectionState {
  id             Int       @id @default(autoincrement())
  userId         Int
  sessionId      Int
  tokenHash      String    @unique
  intendedAction String
  projectId      Int?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId])
  @@index([projectId])
}

model GitHubIdentity {
  id                  Int       @id @default(autoincrement())
  userId              Int       @unique
  githubUserId        String    @unique
  githubLogin         String
  linkedAt            DateTime  @default(now())
  lastAuthenticatedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GitHubOAuthState {
  id         Int                @id @default(autoincrement())
  tokenHash  String             @unique
  purpose    GitHubOAuthPurpose
  userId     Int?
  sessionId  Int?
  rememberMe Boolean            @default(false)
  returnTo   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime           @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId])
  @@index([purpose, expiresAt])
}

model GitHubWebhookDelivery {
  id             Int       @id @default(autoincrement())
  deliveryId     String    @unique
  event          String
  action         String?
  installationId String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([installationId])
  @@index([receivedAt])
}

model AuditEvent {
  id             Int            @id @default(autoincrement())
  occurredAt     DateTime       @default(now())
  actorUserId    Int?
  actorType      AuditActorType @default(USER)
  projectId      Int?
  action         String
  resourceType   String
  resourceId     String?
  result         AuditResult    @default(SUCCESS)
  reasonCode     String?
  requestId      String?
  metadataJson   Json?
  retentionUntil DateTime
  createdAt      DateTime       @default(now())

  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([action, occurredAt])
  @@index([retentionUntil])
}

model PrivacyRequest {
  id                  Int                  @id @default(autoincrement())
  userId              Int
  type                PrivacyRequestType
  status              PrivacyRequestStatus @default(PENDING)
  requestedAt         DateTime             @default(now())
  scheduledFor        DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  reasonCode          String?
  processingStartedAt DateTime?
  failureCode         String?
  lastAttemptAt       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([scheduledFor])
  @@index([updatedAt])
}

model PersonalDataExport {
  id          Int                      @id @default(autoincrement())
  userId      Int
  status      PersonalDataExportStatus @default(PENDING)
  format      String                   @default("JSON")
  expiresAt   DateTime
  completedAt DateTime?
  failedAt    DateTime?
  errorCode   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Requisito funcional ou necessidade cadastrada no projeto.
model Requirement {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  type        String   @default("FUNCIONAL")
  status      String   @default("PENDENTE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

// Unidade de trabalho e elo entre planejamento e implementacao.
model Task {
  id                Int       @id @default(autoincrement())
  projectId         Int
  requirementId     Int?
  title             String
  description       String?
  priority          String    @default("MEDIA")
  responsible       String?
  status            String    @default("A_FAZER")
  deadline          DateTime?
  estimatedEffort   Int?
  actualEffort      Int?
  pullRequestId     Int?
  responsibleUserId Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project           Project                @relation(fields: [projectId], references: [id])
  requirement       Requirement?           @relation(fields: [requirementId], references: [id])
  pullRequest       PullRequest?           @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  movements         TaskMovement[]
  historyEntries    TaskHistoryEntry[]
  commitLinks       TaskCommit[]
  commitSuggestions TaskCommitSuggestion[]
  issueLinks        TaskIssue[]
  responsibleUser   User?                  @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([pullRequestId])
  @@index([responsibleUserId])
  @@index([requirementId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
}

// Vinculo de rastreabilidade entre tarefas e commits importados do GitHub.
model TaskCommit {
  id        Int      @id @default(autoincrement())
  taskId    Int
  commitId  Int
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([taskId, commitId])
  @@index([commitId])
}

// Sugestão persistida do RF41. O vínculo canônico só existe em TaskCommit após confirmação.
model TaskCommitSuggestion {
  id               Int                        @id @default(autoincrement())
  projectId        Int
  taskId           Int
  commitId         Int
  status           TaskCommitSuggestionStatus @default(PENDING)
  detectedAt       DateTime                   @default(now())
  reviewedAt       DateTime?
  reviewedByUserId Int?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commit         Commit  @relation(fields: [commitId], references: [id], onDelete: Cascade)
  reviewedByUser User?   @relation("TaskCommitSuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, commitId])
  @@index([projectId, status])
  @@index([commitId])
  @@index([taskId])
  @@index([reviewedByUserId])
}

// Vinculo de rastreabilidade entre tarefas e issues importadas do GitHub.
model TaskIssue {
  id        Int      @id @default(autoincrement())
  taskId    Int
  issueId   Int
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([taskId, issueId])
  @@index([issueId])
}

// Membro interno de um projeto no TRACEFLOW.
model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  email     String?
  role      String   @default("MEMBRO")
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id])
  movements TaskMovement[]

  @@unique([projectId, email])
  @@index([projectId])
}

// Historico de movimentacoes do quadro Kanban do RF08.
model TaskMovement {
  id              Int      @id @default(autoincrement())
  projectId       Int
  taskId          Int
  fromStatus      String
  toStatus        String
  movedBy         String
  projectMemberId Int?
  movedByUserId   Int?
  movedAt         DateTime @default(now())
  sprintId        Int?
  createdAt       DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id])
  task          Task           @relation(fields: [taskId], references: [id])
  projectMember ProjectMember? @relation(fields: [projectMemberId], references: [id])
  movedByUser   User?          @relation(fields: [movedByUserId], references: [id], onDelete: SetNull)

  @@index([projectMemberId])
  @@index([movedByUserId])
  @@index([movedAt])
  @@index([projectId, movedAt])
  @@index([taskId, movedAt])
}

// Histórico funcional e project-scoped exigido pelo RF38.
// AuditEvent permanece como trilha transversal independente.
model TaskHistoryEntry {
  id          Int              @id @default(autoincrement())
  projectId   Int
  taskId      Int
  actorUserId Int
  field       TaskHistoryField
  fromValue   String?
  toValue     String?
  occurredAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUser User    @relation(fields: [actorUserId], references: [id])

  @@index([projectId, occurredAt])
  @@index([taskId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([field, occurredAt])
}

// Commit importado do repositorio GitHub vinculado ao projeto.
model Commit {
  id             Int       @id @default(autoincrement())
  hash           String
  message        String?   @db.Text
  authorName     String?
  authorEmail    String?
  authorUsername String?
  date           DateTime?
  branch         String?
  githubUrl      String?
  projectId      Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLinks       TaskCommit[]
  taskSuggestions TaskCommitSuggestion[]
  branchLinks     CommitBranch[]

  @@unique([projectId, hash])
  @@index([projectId, date])
  @@index([projectId, createdAt])
}

// Branch observada no repositório GitHub do projeto. Registros inativos preservam histórico.
model GitBranch {
  id                Int       @id @default(autoincrement())
  projectId         Int
  name              String
  headSha           String?
  lastSyncedHeadSha String?
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime
  inactiveAt        DateTime?
  reactivatedAt     DateTime?
  reactivationCount Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitLinks CommitBranch[]

  @@unique([projectId, name])
  @@index([projectId, isActive])
  @@index([projectId, isDefault])
}

// Execução persistida permite polling, recuperação após reload e exclusão mútua no banco.
model GitHubSyncRun {
  id                  Int                 @id @default(autoincrement())
  projectId           Int
  requestedByUserId   Int
  activeProjectId     Int?                @unique
  status              GitHubSyncRunStatus @default(QUEUED)
  step                GitHubSyncStep      @default(QUEUED)
  currentBranch       String?
  startedAt           DateTime?
  heartbeatAt         DateTime?
  finishedAt          DateTime?
  durationMs          Int?
  branchCount         Int                 @default(0)
  processedBranches   Int                 @default(0)
  commitPages         Int                 @default(0)
  commitsFound        Int                 @default(0)
  commitsObserved     Int                 @default(0)
  commitsCreated      Int                 @default(0)
  commitLinksCreated  Int                 @default(0)
  pullRequestsFound   Int                 @default(0)
  pullRequestsCreated Int                 @default(0)
  pullRequestsUpdated Int                 @default(0)
  issuesFound         Int                 @default(0)
  issuesCreated       Int                 @default(0)
  issuesUpdated       Int                 @default(0)
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedByUser User    @relation(fields: [requestedByUserId], references: [id])

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
  @@index([requestedByUserId, createdAt])
}

// Um commit canônico pode estar contido em várias branches simultaneamente.
model CommitBranch {
  commitId Int
  branchId Int

  commit Commit    @relation(fields: [commitId], references: [id], onDelete: Cascade)
  branch GitBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([commitId, branchId])
  @@index([branchId])
}

// Pull Request importada do repositorio GitHub e vinculada às Tasks pela FK singular canônica.
model PullRequest {
  id              Int       @id @default(autoincrement())
  githubId        String
  number          Int
  title           String
  description     String?   @db.Text
  state           String?
  authorUsername  String?
  sourceBranch    String?
  targetBranch    String?
  githubUrl       String?
  createdAtGithub DateTime?
  updatedAtGithub DateTime?
  closedAtGithub  DateTime?
  mergedAtGithub  DateTime?
  projectId       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, githubId])
  @@unique([projectId, number])
  @@index([projectId, createdAtGithub])
  @@index([projectId, updatedAtGithub])
}

// Issue importada do repositorio GitHub vinculado ao projeto.
model Issue {
  id               Int       @id @default(autoincrement())
  githubId         String
  number           Int
  title            String
  description      String?   @db.Text
  state            String?
  authorUsername   String?
  assigneeUsername String?
  labels           Json?
  milestone        String?
  githubUrl        String?
  createdAtGithub  DateTime?
  updatedAtGithub  DateTime?
  closedAtGithub   DateTime?
  projectId        Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLinks TaskIssue[]

  @@unique([projectId, githubId])
  @@unique([projectId, number])
  @@index([projectId, createdAtGithub])
  @@index([projectId, updatedAtGithub])
}
