generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum PrivacyRequestType {
  DATA_EXPORT
  ACCOUNT_DEACTIVATION
  ACCOUNT_DELETION
  DATA_CORRECTION
}

enum PrivacyRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
  REJECTED
}

enum PersonalDataExportStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum TaskCommitSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum TaskHistoryField {
  STATUS
  DEADLINE
  RESPONSIBLE
  PRIORITY
  SPRINT
}

enum SprintStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum MilestoneStatus {
  PENDENTE
  CONCLUIDO
}

// Motivo da saida de uma tarefa do escopo de uma sprint (RF10/RF35).
// Em portugues como SprintStatus e MilestoneStatus: e vocabulario de dominio
// exibido ao usuario, nao identificador tecnico.
enum SprintTaskRemovalReason {
  MOVIDA
  REMOVIDA
  TAREFA_EXCLUIDA
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  passwordHash    String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  mustSetPassword Boolean   @default(false)
  sessionVersion  Int       @default(1)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                      Session[]
  passwordResetTokens           PasswordResetToken[]
  memberships                   ProjectMembership[]
  createdInvitations            ProjectInvitation[]    @relation("InvitationCreator")
  acceptedInvitations           ProjectInvitation[]    @relation("InvitationAcceptor")
  responsibleTasks              Task[]
  taskMovements                 TaskMovement[]
  taskHistoryEntries            TaskHistoryEntry[]
  auditEvents                   AuditEvent[]
  privacyRequests               PrivacyRequest[]
  personalDataExports           PersonalDataExport[]
  reviewedTaskCommitSuggestions TaskCommitSuggestion[] @relation("TaskCommitSuggestionReviewer")
}

model Session {
  id             Int       @id @default(autoincrement())
  userId         Int
  tokenHash      String    @unique
  csrfTokenHash  String
  sessionVersion Int
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProjectMembership {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)
  isActive  Boolean     @default(true)
  joinedAt  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, role, isActive])
  @@index([userId, isActive])
}

model ProjectInvitation {
  id           Int         @id @default(autoincrement())
  projectId    Int
  email        String
  role         ProjectRole @default(MEMBER)
  tokenHash    String      @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  acceptedAt   DateTime?
  createdById  Int
  acceptedById Int?
  createdAt    DateTime    @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedBy User?   @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([projectId])
  @@index([email])
  @@index([expiresAt])
}

// Entidade central do TRACEFLOW, com aliases GitHub legados preservados por compatibilidade.
model Project {
  id                       Int       @id @default(autoincrement())
  name                     String
  description              String?
  responsibleTeam          String
  githubOwner              String?
  githubRepo               String?
  githubUrl                String?
  githubRepositoryId       String?
  githubRepositoryName     String?
  githubRepositoryFullName String?
  githubRepositoryUrl      String?
  githubDefaultBranch      String?
  githubIsPrivate          Boolean?
  githubIntegratedAt       DateTime?
  githubAutoSyncEnabled    Boolean   @default(false)
  githubLastSyncAt         DateTime?
  githubSyncStatus         String?
  githubLastSyncError      String?
  githubLastSyncAttemptAt  DateTime?
  status                   String    @default("ATIVO")
  accessCode               String?   @unique
  inviteLink               String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  requirements          Requirement[]
  tasks                 Task[]
  members               ProjectMember[]
  taskMovements         TaskMovement[]
  taskHistoryEntries    TaskHistoryEntry[]
  commits               Commit[]
  pullRequests          PullRequest[]
  issues                Issue[]
  memberships           ProjectMembership[]
  invitations           ProjectInvitation[]
  auditEvents           AuditEvent[]
  taskCommitSuggestions TaskCommitSuggestion[]
  sprints               Sprint[]
  milestones            Milestone[]
  sprintTasks           SprintTask[]

  @@unique([githubRepositoryId])
  @@unique([githubRepositoryFullName])
  @@index([status])
  @@index([githubSyncStatus])
  @@index([createdAt])
}

model AuditEvent {
  id             Int            @id @default(autoincrement())
  occurredAt     DateTime       @default(now())
  actorUserId    Int?
  actorType      AuditActorType @default(USER)
  projectId      Int?
  action         String
  resourceType   String
  resourceId     String?
  result         AuditResult    @default(SUCCESS)
  reasonCode     String?
  requestId      String?
  metadataJson   Json?
  retentionUntil DateTime
  createdAt      DateTime       @default(now())

  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([action, occurredAt])
  @@index([retentionUntil])
}

model PrivacyRequest {
  id           Int                  @id @default(autoincrement())
  userId       Int
  type         PrivacyRequestType
  status       PrivacyRequestStatus @default(PENDING)
  requestedAt  DateTime             @default(now())
  scheduledFor DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  reasonCode   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([scheduledFor])
  @@index([updatedAt])
}

model PersonalDataExport {
  id          Int                      @id @default(autoincrement())
  userId      Int
  status      PersonalDataExportStatus @default(PENDING)
  format      String                   @default("JSON")
  expiresAt   DateTime
  completedAt DateTime?
  failedAt    DateTime?
  errorCode   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Requisito funcional ou necessidade cadastrada no projeto.
model Requirement {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  type        String   @default("FUNCIONAL")
  status      String   @default("PENDENTE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

// Unidade de trabalho e elo entre planejamento e implementacao.
model Task {
  id                Int       @id @default(autoincrement())
  projectId         Int
  requirementId     Int?
  title             String
  description       String?
  priority          String    @default("MEDIA")
  responsible       String?
  status            String    @default("A_FAZER")
  deadline          DateTime?
  estimatedEffort   Int?
  actualEffort      Int?
  pullRequestId     Int?
  responsibleUserId Int?
  sprintId          Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project           Project                @relation(fields: [projectId], references: [id])
  requirement       Requirement?           @relation(fields: [requirementId], references: [id])
  pullRequest       PullRequest?           @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  // Ponteiro para a participacao ATIVA, escrito na mesma transacao que
  // SprintTask. Garante no banco "no maximo uma sprint ativa por tarefa" e
  // preserva as consultas existentes; o passado mora em sprintParticipations.
  sprint            Sprint?                @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintParticipations SprintTask[]
  movements         TaskMovement[]
  historyEntries    TaskHistoryEntry[]
  commitLinks       TaskCommit[]
  commitSuggestions TaskCommitSuggestion[]
  issueLinks        TaskIssue[]
  responsibleUser   User?                  @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([pullRequestId])
  @@index([responsibleUserId])
  @@index([requirementId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, sprintId])
}

// Sprint do cronograma do projeto (RF10); base para a evolucao do RF35.
// Janela semiaberta [startDate, endDate): a sprint seguinte pode comecar no
// instante exato em que esta termina, e nunca antes (ADR-010).
model Sprint {
  id          Int          @id @default(autoincrement())
  projectId   Int
  name        String
  objective   String?      @db.Text
  // DateTime, nao @db.Date: o dominio exige o instante exato. Truncar no dia
  // descartaria hora, minuto e fuso informados pelo usuario (ADR-010).
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus @default(PLANEJADA)
  // Linha de base do planejamento (RF35). NAO fecha o escopo: tarefas ainda
  // podem entrar depois, sinalizadas por SprintTask.addedAfterStart.
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]
  sprintTasks      SprintTask[] @relation("SprintMembership")
  carriedOverTasks SprintTask[] @relation("SprintCarryOver")
  milestones       Milestone[]

  @@unique([projectId, name])
  @@index([projectId, status])
  @@index([projectId, startDate])
  @@index([projectId, endDate])
}

// Marco do cronograma do projeto (RF10). Pertence a uma sprint: a conclusao de
// um marco fica ancorada no periodo de desenvolvimento que a produziu.
model Milestone {
  id          Int             @id @default(autoincrement())
  projectId   Int
  sprintId    Int
  title       String
  description String?         @db.Text
  dueDate     DateTime
  status      MilestoneStatus @default(PENDENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, nao Cascade: sprint nunca e excluida (ADR-010 D06), e a restricao
  // faz o banco recusar alto caso alguem reintroduza o caminho de exclusao.
  sprint  Sprint  @relation(fields: [sprintId], references: [id], onDelete: Restrict)

  @@index([projectId, dueDate])
  @@index([projectId, status])
  @@index([sprintId, status])
}

// Participacao de uma tarefa em uma sprint (RF10/RF35).
//
// Fonte de verdade do historico: sobrevive ao encerramento da sprint e a
// exclusao da tarefa. Sem isso, mover uma tarefa da Sprint 1 para a Sprint 2
// apagaria a participacao anterior, e concluir a tarefa depois reescreveria
// retroativamente o resultado de um periodo ja encerrado.
model SprintTask {
  id                  Int                      @id @default(autoincrement())
  projectId           Int
  sprintId            Int
  taskId              Int?
  // Snapshot: o que sobra quando a tarefa e excluida do fluxo operacional.
  taskTitleSnapshot   String
  addedAt             DateTime                 @default(now())
  // Gravado na entrada, nunca recalculado: `startedAt` pode ser lido de outro
  // jeito depois, e a pergunta "entrou antes ou depois do inicio?" tem que ter
  // uma resposta estavel.
  addedAfterStart     Boolean                  @default(false)
  carriedFromSprintId Int?
  removedAt           DateTime?
  removalReason       SprintTaskRemovalReason?
  // Ultimo status observado NESTA sprint, congelado na saida ou no
  // encerramento. E o que torna o RF35 da sprint fechada irretroativo.
  exitStatus          String?
  closedAt            DateTime?

  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint            Sprint  @relation("SprintMembership", fields: [sprintId], references: [id], onDelete: Cascade)
  task              Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  carriedFromSprint Sprint? @relation("SprintCarryOver", fields: [carriedFromSprintId], references: [id], onDelete: SetNull)

  // Uma participacao por par sprint+tarefa: reentrada REABRE o registro em vez
  // de criar outro, coerente com a regra ja vigente de que "saiu e voltou" nao
  // conta como entrada nem saida. taskId nulo (tarefa excluida) nao colide: no
  // MySQL o indice unico admite multiplos NULL.
  @@unique([sprintId, taskId])
  @@index([sprintId, removedAt])
  @@index([taskId, removedAt])
  @@index([carriedFromSprintId])
  @@index([projectId, addedAt])
}

// Vinculo de rastreabilidade entre tarefas e commits importados do GitHub.
model TaskCommit {
  id        Int      @id @default(autoincrement())
  taskId    Int
  commitId  Int
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([taskId, commitId])
  @@index([commitId])
}

// Sugestão persistida do RF41. O vínculo canônico só existe em TaskCommit após confirmação.
model TaskCommitSuggestion {
  id               Int                        @id @default(autoincrement())
  projectId        Int
  taskId           Int
  commitId         Int
  status           TaskCommitSuggestionStatus @default(PENDING)
  detectedAt       DateTime                   @default(now())
  reviewedAt       DateTime?
  reviewedByUserId Int?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commit         Commit  @relation(fields: [commitId], references: [id], onDelete: Cascade)
  reviewedByUser User?   @relation("TaskCommitSuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, commitId])
  @@index([projectId, status])
  @@index([commitId])
  @@index([taskId])
  @@index([reviewedByUserId])
}

// Vinculo de rastreabilidade entre tarefas e issues importadas do GitHub.
model TaskIssue {
  id        Int      @id @default(autoincrement())
  taskId    Int
  issueId   Int
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([taskId, issueId])
  @@index([issueId])
}

// Membro interno de um projeto no TRACEFLOW.
model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  email     String?
  role      String   @default("MEMBRO")
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id])
  movements TaskMovement[]

  @@unique([projectId, email])
  @@index([projectId])
}

// Historico de movimentacoes do quadro Kanban do RF08.
model TaskMovement {
  id              Int      @id @default(autoincrement())
  projectId       Int
  taskId          Int
  fromStatus      String
  toStatus        String
  movedBy         String
  projectMemberId Int?
  movedByUserId   Int?
  movedAt         DateTime @default(now())
  sprintId        Int?
  createdAt       DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id])
  task          Task           @relation(fields: [taskId], references: [id])
  projectMember ProjectMember? @relation(fields: [projectMemberId], references: [id])
  movedByUser   User?          @relation(fields: [movedByUserId], references: [id], onDelete: SetNull)

  @@index([projectMemberId])
  @@index([movedByUserId])
  @@index([movedAt])
  @@index([projectId, movedAt])
  @@index([taskId, movedAt])
}

// Histórico funcional e project-scoped exigido pelo RF38.
// AuditEvent permanece como trilha transversal independente.
model TaskHistoryEntry {
  id          Int              @id @default(autoincrement())
  projectId   Int
  taskId      Int
  actorUserId Int
  field       TaskHistoryField
  fromValue   String?
  toValue     String?
  occurredAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorUser User    @relation(fields: [actorUserId], references: [id])

  @@index([projectId, occurredAt])
  @@index([taskId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([field, occurredAt])
}

// Commit importado do repositorio GitHub vinculado ao projeto.
model Commit {
  id             Int       @id @default(autoincrement())
  hash           String
  message        String?   @db.Text
  authorName     String?
  authorEmail    String?
  authorUsername String?
  date           DateTime?
  branch         String?
  githubUrl      String?
  projectId      Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLinks       TaskCommit[]
  taskSuggestions TaskCommitSuggestion[]

  @@unique([projectId, hash])
  @@index([projectId, date])
  @@index([projectId, createdAt])
}

// Pull Request importada do repositorio GitHub e vinculada às Tasks pela FK singular canônica.
model PullRequest {
  id              Int       @id @default(autoincrement())
  githubId        String
  number          Int
  title           String
  description     String?   @db.Text
  state           String?
  authorUsername  String?
  sourceBranch    String?
  targetBranch    String?
  githubUrl       String?
  createdAtGithub DateTime?
  updatedAtGithub DateTime?
  closedAtGithub  DateTime?
  mergedAtGithub  DateTime?
  projectId       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, githubId])
  @@unique([projectId, number])
  @@index([projectId, createdAtGithub])
  @@index([projectId, updatedAtGithub])
}

// Issue importada do repositorio GitHub vinculado ao projeto.
model Issue {
  id               Int       @id @default(autoincrement())
  githubId         String
  number           Int
  title            String
  description      String?   @db.Text
  state            String?
  authorUsername   String?
  assigneeUsername String?
  labels           Json?
  milestone        String?
  githubUrl        String?
  createdAtGithub  DateTime?
  updatedAtGithub  DateTime?
  closedAtGithub   DateTime?
  projectId        Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLinks TaskIssue[]

  @@unique([projectId, githubId])
  @@unique([projectId, number])
  @@index([projectId, createdAtGithub])
  @@index([projectId, updatedAtGithub])
}
