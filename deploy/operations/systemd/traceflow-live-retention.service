[Unit]
Description=TraceFlow approved retention of expired clean-production records
Wants=network-online.target
After=network-online.target
OnFailure=traceflow-live-retention-alert.service
[Service]
Type=oneshot
User=traceflow-live
Group=traceflow-live
SupplementaryGroups=traceflow
WorkingDirectory=/opt/traceflow/releases/20261019T011508Z-9bc3dad199566afc6fa43d67abba400665d843ea-a6eda960ef55/backend
EnvironmentFile=/etc/traceflow-live/runtime.env
EnvironmentFile=/etc/traceflow-live/api.env
ExecStart=/usr/bin/node /usr/local/libexec/traceflow-live-retention.mjs --apply
UMask=0077
TimeoutStartSec=180
MemoryMax=512M
MemorySwapMax=0
LimitCORE=0
KillMode=control-group
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/traceflow-live/test-evidence
InaccessiblePaths=/var/lib/traceflow/test-evidence /etc/traceflow /opt/traceflow/shared /var/lib/traceflow-recovery
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=null
