# TEMPLATE ONLY. No unattended credentials or writer suspension are implied.
[Unit]
Description=TraceFlow daily maintenance backup request (fresh authorization required)
[Timer]
OnCalendar=*-*-* 03:00:00 UTC
Persistent=false
RandomizedDelaySec=0
Unit=traceflow-recovery-backup.service
[Install]
WantedBy=timers.target
