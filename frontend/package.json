{
  "name": "traceflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend do TRACEFLOW em React",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src test vitest.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"test/**/*.{js,jsx}\" \"*.js\" package.json",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"test/**/*.{js,jsx}\" \"*.js\" package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.11.0",
    "axios": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
